# DropFile Frontend Configuration
# Copy this to .env.local and update with your backend URL.

# Render backend base URL (used for Socket.IO, REST, and chunk transfers).
# For production (deployed backend):
VITE_API_URL=https://<your-render-service>.onrender.com

# For local development only (never used by the GitHub Pages production build):
# VITE_API_URL=http://localhost:3001

# For testing on the same network (replace with your actual IP):
# VITE_API_URL=http://192.168.1.100:3001

